{
  "name": "Iris Dashboard Theme",
  "dataColors": [
    "#2196F3",
    "#4CAF50",
    "#FF9800",
    "#E91E63",
    "#9C27B0",
    "#00BCD4",
    "#FFC107",
    "#795548",
    "#607D8B",
    "#F44336"
  ],
  "background": "#F5F7FA",
  "foreground": "#333333",
  "tableAccent": "#2196F3",
  "good": "#4CAF50",
  "neutral": "#FF9800",
  "bad": "#F44336",
  "maximum": "#2196F3",
  "center": "#FF9800",
  "minimum": "#4CAF50",
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#333333"
              }
            }
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#E0E0E0"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "color": {
              "solid": {
                "color": "#000000"
              }
            },
            "position": "outer",
            "preset": "bottomRight",
            "transparency": 85,
            "distance": 2,
            "size": 4,
            "angle": 135
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold",
            "color": {
              "solid": {
                "color": "#2196F3"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "color": {
              "solid": {
                "color": "#666666"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "data": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 11,
            "color": {
              "solid": {
                "color": "#333333"
              }
            }
          }
        ],
        "selection": [
          {
            "selectAllCheckboxEnabled": true,
            "singleSelect": false
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#333333"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    }
  },
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#2196F3"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#333333"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#333333"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#666666"
    }
  }
}
